{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discard",
  "version": "0.1.0",
  "identifier": "com.discard.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "Discard", "width": 1200, "height": 800 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
